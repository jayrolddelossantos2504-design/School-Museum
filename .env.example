# Copy this file to .env and fill in real local values.
# NEVER commit the real .env file. Placeholders only below.

# Environment: "development" (default) or "production".
# In production, secure cookies are forced on and debug is off.
APP_ENV=development

# Flask. Use a long random value in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL / MariaDB (XAMPP defaults shown as placeholders)
DB_HOST=localhost
DB_PORT=3306
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_NAME=school_museum

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Public site URL used to build permanent item links and QR codes.
# MUST be the real HTTPS domain in production before printing QR labels.
SITE_URL=http://127.0.0.1:5000

# Only used in development. In production cookies are always secure (HTTPS).
SESSION_COOKIE_SECURE=0

# Waitress bind settings (production), used by wsgi.py
HOST=0.0.0.0
PORT=8000

# Max upload request size in bytes (example: 10 MiB)
MAX_CONTENT_LENGTH=10485760
